# ---- Server ----
NODE_ENV=development
PORT=4000
# Set true when running behind Nginx / a load balancer (so client IPs are correct)
TRUST_PROXY=false
# Comma separated list of allowed web origins (mobile apps don't need this). * = allow all
CORS_ORIGINS=*

# ---- Database (PostgreSQL 13+) ----
DATABASE_URL=postgres://chat:chat@127.0.0.1:5432/chatapp

# ---- Secrets (use long random strings in production: `openssl rand -hex 32`) ----
JWT_SECRET=change-me-user-jwt-secret
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
OTP_SECRET=change-me-otp-secret

# Access token lifetime (seconds) and refresh token lifetime (days)
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=60

# ---- OTP / SMS ----
# OTP_DEV_MODE=true returns the OTP in the API response and logs it (NO SMS is sent).
# NEVER enable in production.
OTP_DEV_MODE=true
# SMS_PROVIDER = console | http | twilio
SMS_PROVIDER=console
# Generic HTTP gateway (POST JSON {"to": "+92...", "message": "..."} with Bearer token)
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Uploads ----
UPLOAD_DIR=./uploads

# ---- Push notifications (optional) ----
# Path to a Firebase service-account JSON file. Leave empty to disable push.
FIREBASE_SERVICE_ACCOUNT_PATH=
