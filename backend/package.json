{
  "name": "chatapp-backend",
  "version": "1.0.0",
  "description": "Telegram-style messaging app \u2014 Phase 1 backend (REST API + Socket.IO + admin API)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "e2e": "node test/e2e/api.e2e.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "optionalDependencies": {
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
