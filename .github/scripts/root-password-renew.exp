#!/usr/bin/expect -f
# Hetzner marks the emailed / reset root password as "expired": the first login must change it.
# This answers that prompt with a temporary password, then sets the original password back
# (root may reuse it with chpasswd) and stops it from expiring, so later logins just work.
set timeout 40
set host $env(HOST)
set pass $env(SSHPASS)
set temp $env(TEMP_PASS)
spawn ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR root@$host
expect {
  -re "(?i)password:" { send "$pass\r" }
  timeout { puts "\nRENEW: no password prompt"; exit 2 }
}
expect {
  -re "(?i)current.*password:" { send "$pass\r"; exp_continue }
  -re "(?i)new password:" { send "$temp\r"; exp_continue }
  -re "(?i)retype.*password:" { send "$temp\r"; exp_continue }
  -re "(?i)permission denied" { puts "\nRENEW: password not accepted"; exit 3 }
  -re "(?i)(passwd: password updated|# $|\\$ $)" { }
  timeout { puts "\nRENEW: no shell"; exit 4 }
  eof { puts "\nRENEW: connection closed after the password change"; exit 5 }
}
send "printf '%s\\n' 'root:$pass' | chpasswd && chage -M 99999 -d \$(date +%F) root && echo RENEW_OK\r"
expect {
  "RENEW_OK" { }
  timeout { puts "\nRENEW: could not restore the password"; exit 6 }
}
send "exit\r"
expect eof
