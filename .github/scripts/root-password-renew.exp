#!/usr/bin/expect -f
# Hetzner marks the emailed / reset root password as "expired": the first login must change it,
# and the server then closes that connection. Step 1 changes it to a temporary password;
# step 2 logs in with that and sets the original password back (stops it expiring), so later
# logins with SERVER_PASSWORD just work.
set timeout 60
match_max 100000
set host $env(HOST)
set pass $env(SSHPASS)
set temp $env(TEMP_PASS)
set ssh_opts {-tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o PubkeyAuthentication=no}

# ---- step 1: the forced change
eval spawn ssh $ssh_opts root@$host
expect {
  -nocase -ex "password:" { send -- "$pass\r" }
  timeout { puts "\nRENEW: no login prompt"; exit 2 }
}
expect {
  -nocase -ex "current password:" { send -- "$pass\r" }
  -nocase -ex "permission denied" { puts "\nRENEW: password not accepted"; exit 3 }
  timeout { puts "\nRENEW: no change prompt"; exit 4 }
}
expect {
  -nocase -ex "new password:" { send -- "$temp\r" }
  timeout { puts "\nRENEW: no new-password prompt"; exit 4 }
}
expect {
  -nocase -ex "new password:" { send -- "$temp\r" }
  timeout { puts "\nRENEW: no retype prompt"; exit 4 }
}
expect {
  -nocase -ex "updated successfully" { }
  -nocase -ex "bad password" { puts "\nRENEW: temporary password rejected"; exit 5 }
  timeout { }
  eof { }
}
expect eof
puts "\nRENEW: step 1 done"

# ---- step 2: put the original password back
set timeout 60
eval spawn ssh $ssh_opts root@$host
expect {
  -nocase -ex "password:" { send -- "$temp\r" }
  timeout { puts "\nRENEW: no second login prompt"; exit 6 }
}
expect {
  -re {[#$] $} { }
  timeout { }
}
send -- "printf '%s\\n' 'root:$pass' | chpasswd && chage -M 99999 -d \$(date +%F) root && echo RENEW_\"OK\"\r"
expect {
  "RENEW_OK" { puts "\nRENEW: done" }
  timeout { puts "\nRENEW: could not restore the password"; exit 7 }
}
send -- "exit\r"
expect eof
